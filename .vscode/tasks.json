{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Docker Services",
      "type": "shell",
      "command": "docker-compose up -d",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Start Medplum Backend",
      "type": "shell",
      "command": "cd medplum-backend/server && npm run dev",
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": ".",
              "file": 1,
              "location": 2,
              "message": 3
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".",
            "endsPattern": "Debugger listening on ws://"
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "dependsOn": [
        "Start Docker Services"
      ]
    },
    {
      "label": "Start Medplum Admin App",
      "type": "shell",
      "command": "cd medplum-admin/app && npm run dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "dependsOn": [
        "Start Medplum Backend"
      ]
    },
    {
      "label": "Start All Services",
      "dependsOn": [
        "Start Docker Services",
        "Start Medplum Backend",
        "Start Medplum Admin App"
      ],
      "problemMatcher": []
    },
    {
      "label": "Stop Docker Services",
      "type": "shell",
      "command": "docker-compose down",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}